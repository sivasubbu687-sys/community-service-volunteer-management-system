# Copy this file to secrets.properties and fill in real values (secrets.properties is git-ignored).
# You can also set these as environment variables instead.
DB_PASSWORD=your-mysql-password
# Gmail: turn on 2-Step Verification, then create a 16-letter App password
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-gmail-app-password
# At least 32 characters, random. Example generator: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-value-of-32-plus-characters
# Default admin account, created on first startup only when no ADMIN exists
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=choose-a-strong-password

# Website address used in password reset links (no trailing slash)
APP_BASE_URL=http://localhost:8080

# Google sign-in (optional). Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add this redirect URI:
#   http://localhost:8080/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
